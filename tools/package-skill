#!/usr/bin/env bash
# package-skill <skill-dir> [-o <out.zip>]
#
# Zips a skill exactly as committed, for upload to a skill marketplace.
# Only tracked files at HEAD go in, under a <skill-name>/ prefix, so local
# edits, node_modules and other ignored files never ship.
#
#   package-skill skills/explaining-visually         ./explaining-visually.zip
#   package-skill skills/foo -o ~/Downloads/foo.zip  another output path
#
# Refuses while the skill has uncommitted changes, and prints the commit the
# zip was built from so you can tell later whether a listing is stale.

set -euo pipefail

dir=""
out=""

while [ $# -gt 0 ]; do
    case "$1" in
        -o) out="${2:-}"; shift 2 ;;
        -h|--help) sed -n '2,13p' "$0" | cut -c3-; exit 0 ;;
        -*) echo "package-skill: unknown option '$1'" >&2; exit 1 ;;
        *)
            if [ -n "$dir" ]; then
                echo "package-skill: expected one skill directory, got '$1' as well" >&2
                exit 1
            fi
            dir="$1"
            shift
            ;;
    esac
done

if [ -z "$dir" ] || [ ! -f "$dir/SKILL.md" ]; then
    echo "package-skill: '$dir' is not a skill directory (no SKILL.md)" >&2
    exit 1
fi

name=$(basename "$(cd "$dir" && pwd)")
top=$(git -C "$dir" rev-parse --show-toplevel)
prefix=$(git -C "$dir" rev-parse --show-prefix)
prefix=${prefix%/}

if [ -z "$prefix" ]; then
    echo "package-skill: '$dir' is the repository root, not a skill inside it" >&2
    exit 1
fi

if [ -n "$(git -C "$dir" status --porcelain -- .)" ]; then
    echo "package-skill: $name has uncommitted changes — commit them first:" >&2
    git -C "$dir" status --short -- . >&2
    exit 1
fi

if [ -z "$out" ]; then
    out="$PWD/$name.zip"
fi
case "$out" in
    /*) ;;
    *) out="$PWD/$out" ;;
esac

git -C "$top" archive --format=zip --prefix="$name/" -o "$out" "HEAD:$prefix"

commit=$(git -C "$dir" log -1 --format='%h %s' -- .)
files=$(git -C "$top" ls-tree -r --name-only "HEAD:$prefix" | wc -l | tr -d ' ')
echo "$out"
echo "$files file(s), last change: $commit"
